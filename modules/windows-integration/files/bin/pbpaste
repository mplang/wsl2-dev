#!/bin/sh
# pbpaste -- print the Windows clipboard's text
# (wsl2-dev:windows-integration)
#
#   pbpaste > notes.txt
#   pbpaste | wc -l

powershell=$(wslpath -u 'C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe')
# UTF-8 output, and Windows line endings (CRLF) become Linux ones (LF)
"$powershell" -NoProfile -NonInteractive -Command \
    '[Console]::OutputEncoding = [Text.Encoding]::UTF8; [Console]::Write((Get-Clipboard -Raw))' \
    | tr -d '\r'

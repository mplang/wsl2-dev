# Gruvbox Dark (https://github.com/morhetz/gruvbox)
# wsl2-dev:theme -- see the theme module's README for each key.
THEME_NAME='Gruvbox Dark'

# --- Tools with their own theme ---
VIM_COLORSCHEME='gruvbox'
VIM_BACKGROUND='dark'
AIRLINE_THEME='gruvbox'
BAT_THEME='gruvbox-dark'

# --- Terminal (Windows Terminal scheme / Terminal.app profile) ---
TERM_SCHEME='Gruvbox Dark'
TERM_BG='#282828'
TERM_FG='#ebdbb2'
TERM_CURSOR='#ebdbb2'
TERM_SELECTION='#665c54'
#         black     red       green     yellow    blue      purple    cyan      white
TERM_ANSI=('#282828' '#cc241d' '#98971a' '#d79921' '#458588' '#b16286' '#689d6a' '#a89984'
           '#928374' '#fb4934' '#b8bb26' '#fabd2f' '#83a598' '#d3869b' '#8ec07c' '#ebdbb2')

# --- Named colors (LS_COLORS) ---
C_RED='#fb4934'
C_ORANGE='#fe8019'
C_YELLOW='#fabd2f'
C_GREEN='#b8bb26'
C_CYAN='#8ec07c'
C_BLUE='#83a598'
C_PURPLE='#d3869b'
C_GRAY='#928374'

# --- UI roles (tmux, fzf, zsh) ---
UI_BG1='#3c3836'      # status bar, fzf current line
UI_BG2='#504945'      # inactive window tabs, messages
UI_BG3='#665c54'      # session segment, borders
UI_FG='#ebdbb2'
UI_FG_DIM='#a89984'   # secondary text
UI_FG_ALT='#bdae93'   # host segment
UI_ACCENT='#fabd2f'   # current window tab
UI_HILITE='#fb4934'   # fzf prompt/pointer/matches, bell
UI_INFO='#8ec07c'     # fzf counters
UI_COMMENT='#928374'  # autosuggestions, fzf headers

# --- OS (Windows / macOS) ---
OS_APPEARANCE='dark'
OS_ACCENT='#d65d0e'
